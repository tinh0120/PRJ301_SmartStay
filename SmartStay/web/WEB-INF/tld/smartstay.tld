<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">

    <tlib-version>1.0</tlib-version>
    <short-name>e</short-name>
    <uri>/WEB-INF/tld/smartstay.tld</uri>

    <function>
        <description>HTML-escapes text to prevent XSS</description>
        <name>esc</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String esc(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Formats money as VND</description>
        <name>money</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String money(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Formats timestamp as yyyy-MM-dd HH:mm</description>
        <name>datetime</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String datetime(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Formats date as yyyy-MM-dd</description>
        <name>date</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String date(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>URL-encodes query string values</description>
        <name>url</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String url(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Parses amenities CSV into list of AmenityInfo with icon paths</description>
        <name>amenities</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.util.List amenities(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Returns compact subset of amenities</description>
        <name>compactAmenities</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.util.List compactAmenities(java.lang.Object, java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Returns room gallery thumbnail images</description>
        <name>gallery</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.util.List gallery(java.lang.Object, java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Returns display name for room number</description>
        <name>roomName</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String roomName(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Formats date or timestamp with weekday: EEE, dd/MM/yyyy · HH:mm</description>
        <name>weekdayDatetime</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String weekdayDatetime(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Formats time only as HH:mm</description>
        <name>time</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String time(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Computes duration between start and end</description>
        <name>duration</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String duration(java.lang.Object, java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Converts status code into human-readable title</description>
        <name>humanStatus</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String humanStatus(java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Returns human-readable label for catalog sort and direction</description>
        <name>sortLabel</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String sortLabel(java.lang.Object, java.lang.Object)</function-signature>
    </function>

    <function>
        <description>Formats a timestamp or date into relative time (e.g. 3 min ago)</description>
        <name>timeAgo</name>
        <function-class>util.ElFunctions</function-class>
        <function-signature>java.lang.String timeAgo(java.lang.Object)</function-signature>
    </function>

</taglib>
